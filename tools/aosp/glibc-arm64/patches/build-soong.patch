diff --git a/rust/rust.go b/rust/rust.go
index c4fd14859..fa371f7d3 100644
--- a/rust/rust.go
+++ b/rust/rust.go
@@ -728,6 +728,21 @@ func (mod *Module) Init() android.Module {
 	android.InitAndroidArchModule(mod, mod.hod, mod.multilib)
 	android.InitApexModule(mod)
 
+	// a4l: there is no Rust toolchain for the glibc arm64 host, so Rust modules are disabled
+	// there. Host ART does not need them.
+	android.AddLoadHook(mod, func(ctx android.LoadHookContext) {
+		type props struct {
+			Target struct {
+				Linux_glibc_arm64 struct {
+					Enabled *bool
+				}
+			}
+		}
+		p := &props{}
+		p.Target.Linux_glibc_arm64.Enabled = proptools.BoolPtr(false)
+		ctx.AppendProperties(p)
+	})
+
 	android.InitDefaultableModule(mod)
 	return mod
 }
