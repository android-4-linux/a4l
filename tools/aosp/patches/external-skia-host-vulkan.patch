 #ifndef SK_SUPPORT_GPU
-#define SK_SUPPORT_GPU 0
+#define SK_SUPPORT_GPU 1
+#endif
+
+// acl P2.4/S4a: enable the Ganesh Vulkan backend for the host build so android.graphics
+// can render GPU-native into acl's dma-buf VkImage (zero-copy present). Skia calls Vulkan
+// through consumer-provided function pointers (GrVkGetProc), so libskia needs no vk loader.
+#ifndef SK_USE_VMA
+#define SK_USE_VMA
+#endif
+#ifndef SK_VULKAN
+#define SK_VULKAN
 #endif
 
