# SPDX-License-Identifier: Apache-2.0
# dmabuf-codec (MIT, Joel Winarske) - hardware video decode engines behind one interface
# (V4L2 stateful and stateless, OpenMAX IL, VA-API), each handing out its decoded frames as
# dma-bufs. media/dma_codec.cpp puts it under MediaCodec. Pinned to a commit, never a branch.
#
# For local development against a sibling checkout instead of cloning, symlink it in as
# subprojects/dmabuf-codec.
[wrap-git]
directory = dmabuf-codec
url = https://github.com/jwinarske/dmabuf-codec.git
revision = cf07d413d6c8fade1fb6fe48f3c6341388f5929c
depth = 1
[provide]
dmabuf-codec = dmabuf_codec_dep
