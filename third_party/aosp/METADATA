# third_party METADATA — the AOSP pin (Gate G2.c). Sources are NOT vendored in-tree
# yet; classes are pulled per-package against a budget (tools/fw_extract.py) as G2.d+
# needs them. This records the pin every extraction and vendor step must use.

name: "aosp"
description: "Vendored AOSP components: art (host), frameworks/base subset, libandroidfw, libziparchive, bionic, CTS, packages/services/Car."
license: "Apache-2.0"   # bionic subtree is BSD; record per-component below when vendored.

# Platform pinning. Target API level 33 (Tiramisu) per ADR-0002. The pinned tag is
# a real AOSP release; the manifest sha is platform/manifest at that tag. All
# projects (frameworks/base, external/skia, ...) inherit the tag as their default
# revision, so a single tag pins the whole tree. Resolved 2026-07-10 from
# android.googlesource.com/platform/manifest/+refs/tags.
platform:
  api_level: 33
  manifest_url: "https://android.googlesource.com/platform/manifest"
  branch: "android-13.0.0_r84"
  manifest_sha: "05bc4f23cd577692d879cb1ab7ec1c0a583d2f83"
  # Local checkout the extraction/vendoring tooling runs against. Configurable via
  # $ACL_AOSP_ROOT; tools/vendor_framework.py defaults to this path.
  local_checkout: "/home/joel/aosp"
  # Create it (repo init -b <branch> -u <url>, then a partial sync of the java trees):
  #   repo init -u https://android.googlesource.com/platform/manifest -b android-13.0.0_r84
  #   repo sync platform/frameworks/base platform/external/skia   # (partial sync)

# Automotive Car API is versioned INDEPENDENTLY of the platform API (plan.md §A01.1).
# Record the platform-tag <-> car-tag pairing here when the automotive path is vendored.
automotive:
  car_release_tag: "TODO: packages/services/Car release validated against android-13.0.0_r84"
  platform_pairing: "android-13.0.0_r84"

# Skia pairing (A02.2): external/skia is pinned by the SAME manifest tag, so the
# paired Skia is external/skia @ android-13.0.0_r84 (not a loose m-branch number).
# Must match subprojects/skia.wrap and third_party/skia/METADATA — single pinned Skia.
skia_pin: "external/skia @ android-13.0.0_r84"

components:
  - path: "art"                     # license: Apache-2.0
  - path: "frameworks/base"         # license: Apache-2.0 (curated subset)
  - path: "system/libandroidfw"     # license: Apache-2.0
