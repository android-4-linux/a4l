# SPDX-License-Identifier: Apache-2.0
# Provenance: plan.md §A01.1 (ACL_PROFILE_AUTOMOTIVE). No GPL-3.0 sources.

option(
  'profile_automotive',
  type : 'boolean',
  value : true,
  description : 'Build the automotive profile: svc/car vehicle services, hosts/cal Car App Library host, hosts/media bridge. Default ON per plan.md §A01.1. An OFF build must emit zero automotive symbols (CI nm-diff gate).',
)

option(
  'tests',
  type : 'boolean',
  value : true,
  description : 'Build the Tier A unit tests and test harnesses under tests/.',
)

option(
  'wcs_root',
  type : 'string',
  value : '',
  description : 'Path to the wayland-cxx-scanner (wcs) checkout providing the CRTP Wayland bindings (scanner tool + wl/ header framework). Empty auto-detects a sibling checkout. When wcs + wayland-client are found, wm/ builds the real Wayland presenter; otherwise wm/ is a stub. Consumed as a prebuilt artifact per plan.md Addendum A02.',
)

option(
  'android_jar',
  type : 'string',
  value : '',
  description : 'Path to the api-33 public android.jar (stub API, ADR-0002 base boot-classpath layer beneath the acl shims). Empty tries $ACL_AOSP_ROOT/prebuilts/sdk/33/public/android.jar (default /mnt/dev/aosp). When present it is staged and baked in as the default framework, so `acl run <apk>` resolves the whole android.* surface (stub bodies throw on call = demand-driven).',
)

option(
  'skia_prefix',
  type : 'string',
  value : '',
  description : 'Path to a pinned Skia install prefix (lib/*.a + include/core/...), shared with wcs (ADR-4/A02.2). Empty auto-detects the standalone install (~/.local/skia-m150). Enables the Skia-backed gfx Surface (ACL_HAVE_SKIA).',
)
