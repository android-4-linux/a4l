# SPDX-License-Identifier: Apache-2.0
# Provenance: plan.md §A01.1 (ACL_PROFILE_AUTOMOTIVE). No GPL-3.0 sources.

option(
  'profile_automotive',
  type : 'boolean',
  value : true,
  description : 'Build the automotive profile: svc/car vehicle services, hosts/cal Car App Library host, hosts/media bridge. Default ON per plan.md §A01.1. An OFF build must emit zero automotive symbols (CI nm-diff gate).',
)

option(
  'tests',
  type : 'boolean',
  value : true,
  description : 'Build the Tier A unit tests and test harnesses under tests/.',
)

option(
  'wcs_root',
  type : 'string',
  value : '',
  description : 'Path to the wayland-cxx-scanner (wcs) checkout providing the CRTP Wayland bindings (scanner tool + wl/ header framework). Empty auto-detects a sibling checkout. When wcs + wayland-client are found, wm/ builds the real Wayland presenter; otherwise wm/ is a stub. Consumed as a prebuilt artifact per plan.md Addendum A02.',
)
