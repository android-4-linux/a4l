# SPDX-License-Identifier: Apache-2.0
# Provenance: plan.md §A01.1 (ACL_PROFILE_AUTOMOTIVE). No GPL-3.0 sources.

option(
  'profile_automotive',
  type : 'boolean',
  value : true,
  description : 'Build the automotive profile: svc/car vehicle services, hosts/cal Car App Library host, hosts/media bridge. Default ON per plan.md §A01.1. An OFF build must emit zero automotive symbols (CI nm-diff gate).',
)

option(
  'tests',
  type : 'boolean',
  value : true,
  description : 'Build the Tier A unit tests and test harnesses under tests/.',
)

option(
  'net_backend',
  type : 'combo',
  choices : ['auto', 'networkd', 'networkmanager', 'connman', 'null'],
  value : 'auto',
  description : 'svc/net connectivity backend translated to android.net.ConnectivityManager. auto compiles every backend and probes the D-Bus bus at runtime (systemd-networkd/NetworkManager on desktop, ConnMan on device); the named modes force one. null (or no sdbus-c++) is the offline default. sdbus-c++ is LGPL-2.1, dynamically linked (policy-compliant).',
)

option(
  'wcs_root',
  type : 'string',
  value : '',
  description : 'Path to an out-of-tree wayland-cxx-scanner (wcs) checkout providing the CRTP Wayland bindings (scanner tool + wl/ header framework), already configured and built — the scanner is expected at <path>/build/src/wayland-cxx-scanner. Empty tries a ../wayland-cxx-scanner sibling, then falls back to subprojects/wayland-cxx-scanner.wrap, which Meson clones at the pinned tag and builds. When wcs + wayland-client + wayland-protocols + xkbcommon are all found, wm/ builds the real Wayland presenter; otherwise wm/ is a stub. plan.md Addendum A02.',
)

option(
  'android_jar',
  type : 'string',
  value : '',
  description : 'Path to the api-33 public android.jar (stub API, ADR-0002 base boot-classpath layer beneath the acl shims). Empty tries $ACL_AOSP_ROOT/prebuilts/sdk/33/public/android.jar (default /mnt/dev/aosp). When present it is staged and baked in as the default framework, so `acl run <apk>` resolves the whole android.* surface (stub bodies throw on call = demand-driven).',
)

option(
  'skia_prefix',
  type : 'string',
  value : '',
  description : 'Path to a pinned Skia install prefix (lib/*.a + include/core/...), shared with wcs (ADR-4/A02.2). Empty searches $ACL_SKIA_PREFIX, then ~/.local/skia-m150, ~/.local/skia, ../skia-m150, /opt/skia-m150 and /usr/local/skia-m150. Skia is not built by Meson; produce a prefix with wcs scripts/build-skia.sh at the shared chrome/m150 pin (third_party/skia/METADATA). Enables the Skia-backed gfx Surface (ACL_HAVE_SKIA) and, with vulkan + vulkan-hpp + libdrm, the Ganesh Vulkan present path.',
)
